<?xml version="1.0" encoding="utf-8"?>
<!-- The provisional Android sample (S1.c.6). extractNativeLibs stays false so the two JNI
     libraries are loaded straight from the Stored, 16 KiB aligned APK entries. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="@string/app_name"
        android:extractNativeLibs="false"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".SampleLauncherActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Kept exported under its original component name for the measured s1c_smoke harness. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/demo_direct_xml"
            android:configChanges="orientation|screenSize" />
        <activity
            android:name=".ComposeInteropActivity"
            android:exported="false"
            android:label="@string/demo_compose_interop"
            android:configChanges="orientation|screenSize" />
        <activity
            android:name=".ComposeVideoActivity"
            android:exported="false"
            android:label="@string/demo_compose_native"
            android:configChanges="orientation|screenSize" />
        <activity
            android:name=".ComposeSwapActivity"
            android:exported="false"
            android:label="@string/demo_compose_swap"
            android:configChanges="orientation|screenSize" />
    </application>
</manifest>
