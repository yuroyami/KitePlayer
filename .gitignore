.idea/
# The Gradle consumer projects under verification/ keep their own Gradle state.
.gradle/
.kotlin/
build/
**/build/
local.properties
.DS_Store
captures/
*.iml
*.hprof
**/.kotlin-build-tools/

# Reference player source trees. The plan tells you to clone mpv, VLC, QMPlay2 and libplacebo
# into vendor/ for architecture study. That is ~230 MB of someone else's source under GPL and
# LGPL terms. It must never be tracked here, and never copied into this repo's own sources.
vendor/

# Generated test clips. Regenerate them with scripts/testmedia.sh.
testmedia/

# Native binaries fetched or built for the JNI bridge and the FFmpeg link.
native-libs/

# An owner-supplied sample song whose tags name no artist and no licence. It stays on the
# working machine until its licence is known.
kiteplayer-sample-shared/media/SynthyBattle.mp3

# Python bytecode left by running or compiling a script.
__pycache__/

# Files that the build copies beside the web pages and the web tests: the KiteFFmpeg codec
# module, the libass module and the test clip. The web-assets plugin writes them.
/kiteplayer-sample-web/resources/*
!/kiteplayer-sample-web/resources/index.html
/kiteplayer-libass/testResources@wasmJs/
/kiteplayer-ffmpeg/testResources@wasmJs/
/kiteplayer-web-worker/testResources@wasmJs/

# The test clip and the sample songs, copied into the Android sample by the sample-media plugin.
/kiteplayer-sample-android/assets/

# The Android signing keys of the Android sample. Never commit them.
/kiteplayer-sample-android/keystore.properties
