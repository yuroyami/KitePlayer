# Reference player source trees. The plan tells you to clone mpv, VLC, QMPlay2 and libplacebo
# into vendor/ for architecture study. That is ~230 MB of someone else's source under GPL and
# LGPL terms. It must never be tracked here, and never copied into this repo's own sources.
vendor/

# Generated test clips. Regenerate them with scripts/testmedia.sh.
testmedia/

# Native binaries fetched or built for the JNI bridge and the FFmpeg link.
native-libs/

# Audioviz pattern revamp specifications, plans and their evidence. The folder holds device
# videos and stills, so it stays on the working machine and out of the history.
audioviz-revamp/

# An owner-supplied sample song whose tags name no artist and no licence. It stays on the
# working machine until its licence is known.
kiteplayer-sample-shared/media/SynthyBattle.mp3
