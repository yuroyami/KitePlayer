<?xml version="1.0" encoding="utf-8"?>
<!-- The provisional Android sample. extractNativeLibs stays false so the two JNI
     libraries are loaded straight from the Stored, 16 KiB aligned APK entries. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The library's media service keeps the song playing after the app leaves the screen. A media
         session's notification needs no notification permission on Android 13 and later. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- The notification keeps the processor and Wi-Fi awake while the song plays or loads. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <application
        android:label="@string/app_name"
        android:extractNativeLibs="false"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <!-- The front screen: the song and the audio visualiser. It keeps running through a rotation. -->
        <activity
            android:name=".VisualizerActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The comparisons, opened from the front screen. Still exported for explicit launches. -->
        <activity
            android:name=".SampleLauncherActivity"
            android:exported="true"
            android:label="@string/app_name" />
        <!-- Kept exported under its original component name for the measured s1c_smoke harness. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/demo_direct_xml"
            android:configChanges="orientation|screenSize" />
        <activity
            android:name=".ComposeInteropActivity"
            android:exported="false"
            android:label="@string/demo_compose_interop"
            android:configChanges="orientation|screenSize" />
        <activity
            android:name=".ComposeVideoActivity"
            android:exported="false"
            android:label="@string/demo_compose_native"
            android:configChanges="orientation|screenSize" />
        <activity
            android:name=".ComposeSwapActivity"
            android:exported="false"
            android:label="@string/demo_compose_swap"
            android:configChanges="orientation|screenSize" />
        <!-- Started and stopped by KitePlayerPlatform.attachMediaNotification. -->
        <service
            android:name="io.github.yuroyami.kiteplayer.session.KitePlayerMediaService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
